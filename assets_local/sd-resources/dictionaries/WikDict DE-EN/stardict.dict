t erwerben<ol><li><div>an</div></li><li><div>for</div></li><li><div>offer</div></li><li><div>submit</div></li><li><div>subscribe</div></li><li><div>tender</div></li></ol></li></ol></div><div>/<font color="gray">ˈt͡saɪ̯çnɐ</font>/<br>
